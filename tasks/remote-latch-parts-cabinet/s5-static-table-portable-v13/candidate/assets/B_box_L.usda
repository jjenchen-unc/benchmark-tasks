#usda 1.0
(
    defaultPrim = "Fixture"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Fixture"
{
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    def "links"
    {
        def Xform "B_box_L" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (-0.0014032258, 0, 0)
            float3 physics:diagonalInertia = (0.00014478626, 0.00015444666, 0.00017356627)
            float physics:mass = 0.31
            quatf physics:principalAxes = (-0.5, 0.5, 0.5, 0.5)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cube "B_box_L_geom" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </Fixture/material> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                float physxCollision:contactOffset = 0.00025
                float physxCollision:restOffset = 0
                color3f[] primvars:displayColor = [(0.85, 0.55, 0.15)]
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.05, 0.05, 0.06)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Cube "B_box_L_tab" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </Fixture/material> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                float physxCollision:contactOffset = 0.00025
                float physxCollision:restOffset = 0
                color3f[] primvars:displayColor = [(0.85, 0.55, 0.15)]
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.037, 0.02, 0.044)
                double3 xformOp:translate = (-0.0435, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }
        }
    }

    def Material "material" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 1.1
        float physics:restitution = 0
        float physics:staticFriction = 1.1
    }
}

