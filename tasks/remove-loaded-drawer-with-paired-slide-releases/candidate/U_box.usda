#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset"
{
    quatd xformOp:orient = (1, 0, 0, 0)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

    def Xform "U_box" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0.06, 0, -0.005)
        float3 physics:diagonalInertia = (0.000205964, 0.00114749, 0.00117073)
        float physics:mass = 0.730887
        quatf physics:principalAxes = (1, 0, 0, 0)
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Cube "U_box_g" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </Asset/materials/mu_0_5> (
                bindMaterialAs = "weakerThanDescendants"
            )
            bool physics:collisionEnabled = 1
            custom float physxCollision:contactOffset = 0.0005
            custom float physxCollision:restOffset = 0
            color3f[] primvars:displayColor = [(0.2, 0.32, 0.45)]
            float[] primvars:displayOpacity = [1]
            double size = 1
            quatd xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (0.17, 0.056, 0.05)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }

        def Cube "U_box_label"
        {
            color3f[] primvars:displayColor = [(0.92, 0.92, 0.9)]
            float[] primvars:displayOpacity = [1]
            double size = 1
            quatd xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (0.06, 0.036, 0.001)
            double3 xformOp:translate = (0, 0, 0.0255)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }
    }

    def "materials"
    {
        def Material "mu_0_5" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0
            float physics:staticFriction = 0.5
        }
    }
}

