  c,s=math.cos(y),math.sin(y);rz=np.array([[c,-s,0],[s,c,0],[0,0,1]]);q,e,r=ik.solve([.38,-.15,.8225],ik.matrix_to_quat_xyzw(rz@rot),q_init=q,base_pos=station.BASES['right'],iters=250)
  a=G.audit(np.r_[q,[-.04695]*2],F);rows.append(dict(yaw=float(y),q=q.tolist(),e=e,r=r,worst=a[:1]))
 out.append(dict(tilt=tilt,rows=rows));print(tilt,'max errors',max(v['e'] for v in rows),max(v['r'] for v in rows),'min gap',min(v['worst'][0][0] if v['worst'] else .02 for v in rows), 'first',rows[0],flush=True)
