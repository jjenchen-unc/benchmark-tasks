#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
state="$root/artifacts/unc-container"
image=${ROBOCURVE_CONTAINER_IMAGE:-$state/images/isaac-yam.sif}
args=()
job_tmp=
cleanup() { if [[ -n $job_tmp ]]; then rm -rf -- "$job_tmp"; fi; }
trap cleanup EXIT
if [[ ${1:-} == --gpu ]]; then
    : "${SLURM_JOB_ID:?GPU container requires a Slurm allocation}"
    : "${CUDA_VISIBLE_DEVICES:?Slurm GPU visibility is missing}"
    job_tmp=$(mktemp -d /tmp/robocurve-yam.XXXXXX)
    mkdir -p "$job_tmp/apptainer"
    export APPTAINER_TMPDIR="$job_tmp/apptainer"
    export PATH="$state/nvidia/bin:$PATH"
    export NVIDIA_VISIBLE_DEVICES
    NVIDIA_VISIBLE_DEVICES=$(nvidia-smi -i "$CUDA_VISIBLE_DEVICES" --query-gpu=uuid --format=csv,noheader | paste -sd, -)
    export NVIDIA_DRIVER_CAPABILITIES=${ROBOCURVE_NVIDIA_CAPABILITIES:-compute,utility,graphics,display,video}
    args+=(--contain --fakeroot --writable-tmpfs --nvccli --bind "$job_tmp:/tmp"
           --env "CUDA_VISIBLE_DEVICES=$NVIDIA_VISIBLE_DEVICES,TMPDIR=/tmp")
    if [[ -f /usr/share/vulkan/icd.d/nvidia_icd.json ]]; then
        args+=(--bind /usr/share/vulkan/icd.d/nvidia_icd.json:/usr/share/vulkan/icd.d/nvidia_icd.json:ro
               --env VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json)
    fi
    for config_file in /usr/share/glvnd/egl_vendor.d/10_nvidia.json /usr/share/egl/egl_external_platform.d/*nvidia*.json; do
        if [[ -f $config_file ]]; then
            args+=(--bind "$config_file:$config_file:ro")
        fi
    done
    if [[ -f /usr/share/glvnd/egl_vendor.d/10_nvidia.json ]]; then
        args+=(--env __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/10_nvidia.json)
    fi
    while IFS= read -r bus; do
        pci=$(printf '%s' "${bus,,}" | sed -E 's/^0000([0-9a-f]{4}:)/\1/')
        for device_path in /sys/bus/pci/devices/"$pci"/drm/*; do
            device_name=${device_path##*/}
            if [[ -e /dev/dri/$device_name ]]; then
                args+=(--bind "/dev/dri/$device_name:/dev/dri/$device_name")
                printf 'Binding allocated DRM device: %s\n' "$device_name"
            fi
        done
    done < <(nvidia-smi -i "$CUDA_VISIBLE_DEVICES" --query-gpu=pci.bus_id --format=csv,noheader)
    shift
fi
mkdir -p "$state/home" "$state/cache" "$state/python"
"$state/apptainer/bin/apptainer" exec --cleanenv --no-mount hostfs \
    --bind "$root:$root" --home "$state/home:/home/robocurve" --pwd "$root" \
    --env "UV_CACHE_DIR=$state/cache/uv,UV_PYTHON_INSTALL_DIR=$state/python,XDG_CACHE_HOME=$state/cache,OMNI_KIT_ALLOW_ROOT=1" \
    "${args[@]}" "$image" "$@"
