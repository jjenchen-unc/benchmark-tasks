#usda 1.0
(
    defaultPrim = "Wrench"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Wrench" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
)
{
    point3f physics:centerOfMass = (-0.0016934016, -0.07237343, 0)
    float3 physics:diagonalInertia = (0.000015478867, 0.0010201127, 0.0010344548)
    float physics:mass = 0.244
    quatf physics:principalAxes = (0.69905365, 0, 0, 0.71506923)
    bool physxRigidBody:enableCCD = 1
    quatf xformOp:orient = (1, 0, 0, 0)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

    def Cube "wadj_jawm" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </Wrench/wadj_jawm_material>
        rel material:binding:physics = </Wrench/wadj_jawm_material> (
            bindMaterialAs = "weakerThanDescendants"
        )
        float physxCollision:contactOffset = 0.0001
        float physxCollision:restOffset = 0
        color3f[] primvars:displayColor = [(0.72, 0.73, 0.76)]
        double size = 2
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.0055, 0.00932079, 0.0025)
        double3 xformOp:translate = (-0.012273, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Material "wadj_jawm_material" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        token outputs:surface.connect = </Wrench/wadj_jawm_material/Shader.outputs:surface>
        float physics:dynamicFriction = 0.2
        float physics:restitution = 0
        float physics:staticFriction = 0.2

        def Shader "Shader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.72, 0.73, 0.76)
            float inputs:roughness = 0.65
            token outputs:surface
        }
    }

