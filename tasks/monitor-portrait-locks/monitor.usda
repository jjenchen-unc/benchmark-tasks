        }

        def PhysicsFixedJoint "world_fixed"
        {
            rel physics:body1 = </B5Stand/links/sensor_mount>
        }

        def PhysicsFixedJoint "base_wrench_fixed"
        {
            rel physics:body0 = </B5Stand/links/sensor_mount>
            rel physics:body1 = </B5Stand/links/monitor_stand>
            bool physics:collisionEnabled = 0
        }
    }
}

