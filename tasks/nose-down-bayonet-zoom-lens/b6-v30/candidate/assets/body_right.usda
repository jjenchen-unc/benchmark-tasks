        )
        {
            point3f physics:centerOfMass = (0, 0, 0)
            float3 physics:diagonalInertia = (0.000001, 0.000001, 0.000001)
            float physics:mass = 0.01
            quatf physics:principalAxes = (1, 0, 0, 0)
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }
    }

    def "materials"
    {
        def Material "mu_0_15" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.15
            float physics:restitution = 0
            float physics:staticFriction = 0.15
        }

        def Material "mu_1_1" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 1.1
            float physics:restitution = 0
            float physics:staticFriction = 1.1
        }
    }

    def "joints"
    {
        def PhysicsPrismaticJoint "body_right_button_slide" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxJointAxisAPI:linear", "PhysicsDriveAPI:linear"]
        )
        {
            float drive:linear:physics:damping = 2
            float drive:linear:physics:maxForce = inf
            float drive:linear:physics:stiffness = 1500
            float drive:linear:physics:targetPosition = 0
            uniform token drive:linear:physics:type = "force"
            uniform token physics:axis = "X"
            rel physics:body0 = </B6/links/body_right>
            rel physics:body1 = </B6/links/body_right_button>
            bool physics:collisionEnabled = 0
            point3f physics:localPos0 = (0.065, 2.2043642e-18, -0.018)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0, 0, 0, 1)
            quatf physics:localRot1 = (0, 0, 0, 1)
            float physics:lowerLimit = 0
            float physics:upperLimit = 0.004
            float physxJoint:armature = 0.001
            float physxJointAxis:linear:dynamicFrictionEffort = 0
            float physxJointAxis:linear:staticFrictionEffort = 0
        }

        def PhysicsRevoluteJoint "body_right_turn" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxJointAxisAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.000017453292
            float drive:angular:physics:maxForce = inf
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "X"
            rel physics:body0 = </B6/links/body_right>
            rel physics:body1 = </B6/links/body_right_ring>
            bool physics:collisionEnabled = 0
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, 0, -0.70710677, 0)
            quatf physics:localRot1 = (0.70710677, 0, -0.70710677, 0)
            float physics:lowerLimit = -60.382935
            float physics:upperLimit = 2.5
            float physxJoint:armature = 0.0001
            float physxJointAxis:angular:dynamicFrictionEffort = 0.02
            float physxJointAxis:angular:staticFrictionEffort = 0.02
        }

        def PhysicsFixedJoint "world_fixed"
        {
            rel physics:body1 = </B6/links/body_right>
        }
    }
}

