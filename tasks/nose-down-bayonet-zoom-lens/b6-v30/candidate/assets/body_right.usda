#usda 1.0
(
    defaultPrim = "B6"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "B6" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    bool physxArticulation:enabledSelfCollisions = 1
    int physxArticulation:solverPositionIterationCount = 64
    int physxArticulation:solverVelocityIterationCount = 8
    quatd xformOp:orient = (1, 0, 0, 0)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

    def "links"
    {
        def Xform "body_right" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (-0.009750565, 0, -0.03910187)
            float3 physics:diagonalInertia = (0.0021513158, 0.0018468102, 0.0010116044)
            float physics:mass = 0.9545753
            quatf physics:principalAxes = (0, 0.6747744, 0, 0.73802406)
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Cylinder "body_right_face" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI", "PhysicsFilteredPairsAPI"]
            )
            {
                uniform token axis = "Z"
                double height = 0.006
                rel material:binding:physics = </B6/materials/mu_0_15> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                rel physics:filteredPairs
                float physxCollision:contactOffset = 0.0001
                float physxCollision:restOffset = 0
                color3f[] primvars:displayColor = [(0.78, 0.62, 0.25)]
                double radius = 0.04
                quatd xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:translate = (0, 0, -0.003)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }

            def Cylinder "body_right_throat"
            {
                uniform token axis = "Z"
                double height = 0.0006
                color3f[] primvars:displayColor = [(0.03, 0.03, 0.03)]
                double radius = 0.0215
                quatd xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:translate = (0, 0, -0.0002)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }

            def Cube "body_right_index"
            {
                color3f[] primvars:displayColor = [(0.9, 0.1, 0.1)]
                double size = 1
                quatd xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.0036, 0.0016, 0.0004)
                double3 xformOp:translate = (0.0365, 0, 0.0001)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Cube "body_right_shell" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI", "PhysicsFilteredPairsAPI"]
            )
            {
                rel material:binding:physics = </B6/materials/mu_1_1> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                rel physics:filteredPairs
                float physxCollision:contactOffset = 0.0001
                float physxCollision:restOffset = 0
                color3f[] primvars:displayColor = [(0.16, 0.16, 0.17)]
                double size = 1
                quatd xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.13, 0.09, 0.064)
                double3 xformOp:translate = (0, 0, -0.038)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Cube "body_right_grip" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI", "PhysicsFilteredPairsAPI"]
            )
            {
                rel material:binding:physics = </B6/materials/mu_1_1> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                rel physics:filteredPairs
                float physxCollision:contactOffset = 0.0001
                float physxCollision:restOffset = 0
                color3f[] primvars:displayColor = [(0.1, 0.1, 0.11)]
                double size = 1
                quatd xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.032, 0.098, 0.056)
                double3 xformOp:translate = (-0.053, 0, -0.05)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }
        }

        def Xform "body_right_button" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (0.0035, 0, 0)
            float3 physics:diagonalInertia = (7.322917e-8, 7.322917e-8, 1.05625e-7)
            float physics:mass = 0.005
            quatf physics:principalAxes = (0.70710677, 0, 0.70710677, 0)
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0.065, 2.2043642400000018e-18, -0.018000000000000016)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            def Cylinder "body_right_button_cap" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI", "PhysicsFilteredPairsAPI"]
            )
            {
                uniform token axis = "Z"
                double height = 0.007
                rel material:binding:physics = </B6/materials/mu_1_1> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                rel physics:filteredPairs
                float physxCollision:contactOffset = 0.0001
                float physxCollision:restOffset = 0
                color3f[] primvars:displayColor = [(0.75, 0.2, 0.15)]
                double radius = 0.0065
                quatd xformOp:orient = (0.707106790659974, 0, 0.707106771713121, 0)
                double3 xformOp:translate = (0.0035, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
