#usda 1.0
(
    defaultPrim = "Instrument"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Instrument" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    point3f physics:centerOfMass = (0, 0, 0)
    float3 physics:diagonalInertia = (0.00067, 0.00067, 0.00006)
    float physics:mass = 0.3
    quatd xformOp:orient = (1, 0, 0, 0)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

    def Material "material" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 1
        float physics:restitution = 0
        float physics:staticFriction = 1
    }

    def Cylinder "B_inst" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.16
        rel material:binding:physics = </Instrument/material> (
            bindMaterialAs = "weakerThanDescendants"
        )
        float physxCollision:contactOffset = 0.0002
        float physxCollision:restOffset = 0
        color3f[] primvars:displayColor = [(0.8, 0.4, 0.3)]
        double radius = 0.02
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "B_inst_cap" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.012
        rel material:binding:physics = </Instrument/material> (
            bindMaterialAs = "weakerThanDescendants"
        )
        float physxCollision:contactOffset = 0.0002
        float physxCollision:restOffset = 0
        color3f[] primvars:displayColor = [(0.15, 0.15, 0.15)]
        double radius = 0.021
        double3 xformOp:translate = (0, 0, 0.074)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

